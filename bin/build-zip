#!/usr/bin/env bash
#
# Empaquetado reproducible de PLUMA Engine (GOVERNANCE §5.2).
#
# Copia solo los archivos de producción a un directorio limpio, instala
# dependencias sin paquetes de desarrollo, prefija vendor/ con PHP-Scoper
# (para que el ZIP nunca colisione con las dependencias de otro plugin en el
# WordPress del cliente) y produce pluma-engine-{version}.zip listo para
# distribución, junto a su checksum SHA-256.
#
# Reproducibilidad: el build se ejecuta DOS veces en directorios
# independientes y se compara el árbol de archivos resultante (rutas +
# contenido, nunca metadata de timestamp) antes de publicar nada — si el
# mismo commit produce árboles distintos, el script falla en vez de publicar
# un ZIP no determinista.
#
# Uso: bin/build-zip [version]

set -euo pipefail

RAIZ="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$RAIZ"

VERSION="${1:-$(grep -m1 '"version"' composer.json | sed -E 's/.*: *"([^"]+)".*/\1/')}"
DIST_DIR="$RAIZ/build/dist"
DIST_DIR_VERIFICACION="$RAIZ/build/dist-verificacion"
ZIP_PATH="$RAIZ/pluma-engine-${VERSION}.zip"
CHECKSUM_PATH="${ZIP_PATH}.sha256"

echo "== PLUMA Engine — build-zip v${VERSION} =="

# construir_directorio DEST_DIR
# Copia el árbol de producción + dependencias a DEST_DIR/pluma-engine.
construir_directorio() {
    local dest_dir="$1"
    local plugin_dir="$dest_dir/pluma-engine"

    rm -rf "$dest_dir"
    mkdir -p "$plugin_dir"

    cp pluma-engine.php "$plugin_dir/"
    cp uninstall.php "$plugin_dir/"
    cp composer.json "$plugin_dir/"
    # composer.lock viaja con el ZIP: sin él, `composer install` de más abajo
    # resuelve dependencias "latest" en vez de las fijadas — no determinista
    # (detectado por la propia verificación de reproducibilidad de este script).
    cp composer.lock "$plugin_dir/"
    mkdir -p "$plugin_dir/src"
    cp -r src/. "$plugin_dir/src/"

    if [ -d "build/panel" ]; then
        mkdir -p "$plugin_dir/build/panel"
        cp -r build/panel/. "$plugin_dir/build/panel/"
    else
        echo "ERROR: build/panel ausente. Ejecuta 'npm run build' antes de empaquetar." >&2
        exit 1
    fi

    if [ -d languages ]; then
        mkdir -p "$plugin_dir/languages"
        cp -r languages/. "$plugin_dir/languages/"
    fi

    if [ -d recursos ]; then
        # ADR 0024: artefacto real del clasificador NLI pure-PHP
        # (nli-es.rbx + nli-es-vocab.json, ~114 KB) — viaja dentro del
        # plugin, no se descarga aparte.
        mkdir -p "$plugin_dir/recursos"
        cp -r recursos/. "$plugin_dir/recursos/"
    else
        echo "ERROR: recursos/ ausente (falta el modelo NLI entrenado, ADR 0024). Ejecuta tools/entrenamiento-nli/entrenar.php." >&2
        exit 1
    fi

    if [ -f LICENSES-THIRD-PARTY.md ]; then
        cp LICENSES-THIRD-PARTY.md "$plugin_dir/"
    fi

    composer install --no-dev --optimize-autoloader --no-interaction --no-progress --working-dir="$plugin_dir" >&2

    if [ -d "$plugin_dir/vendor" ] && [ "$(ls -A "$plugin_dir/vendor" 2>/dev/null | grep -v '^autoload.php$\|^composer$')" ]; then
        php "$RAIZ/vendor/bin/php-scoper" add-prefix \
            --config="$RAIZ/scoper.inc.php" \
            --working-dir="$plugin_dir" \
            --output-dir="$plugin_dir/build-scoped" \
            --force >&2

        # `scoper.inc.php` escanea con `Finder->in('vendor')`: las rutas de
        # salida de PHP-Scoper ya son relativas a `vendor/`, así que
        # `build-scoped/` ES el nuevo `vendor/` directamente — no
        # `build-scoped/vendor/`. Bug real preexistente (Etapa 6, nunca
        # ejercido de punta a punta hasta `ADR 0024`), corregido aquí.
        rm -rf "$plugin_dir/vendor"
        mv "$plugin_dir/build-scoped" "$plugin_dir/vendor"
        composer dump-autoload --classmap-authoritative --no-dev --working-dir="$plugin_dir" >&2
    fi
}

# huella_directorio DEST_DIR
# Hash agregado y determinista del árbol de archivos (ruta + contenido),
# ignorando toda metadata de timestamp/permisos del sistema de archivos.
huella_directorio() {
    local dest_dir="$1"
    (cd "$dest_dir" && find . -type f -print0 | sort -z | xargs -0 sha256sum) | sha256sum | awk '{print $1}'
}

echo "-> Construyendo (intento 1 de 2)"
construir_directorio "$DIST_DIR"

echo "-> Construyendo (intento 2 de 2, verificación de reproducibilidad)"
construir_directorio "$DIST_DIR_VERIFICACION"

HUELLA_1="$(huella_directorio "$DIST_DIR")"
HUELLA_2="$(huella_directorio "$DIST_DIR_VERIFICACION")"

if [ "$HUELLA_1" != "$HUELLA_2" ]; then
    echo "ERROR: el build no es reproducible — dos ejecuciones del mismo commit produjeron árboles distintos." >&2
    echo "  intento 1: $HUELLA_1" >&2
    echo "  intento 2: $HUELLA_2" >&2
    diff -rq "$DIST_DIR/pluma-engine" "$DIST_DIR_VERIFICACION/pluma-engine" >&2 || true
    rm -rf "$DIST_DIR" "$DIST_DIR_VERIFICACION"
    exit 1
fi

echo "-> Reproducibilidad verificada (huella ${HUELLA_1:0:12}…)"
rm -rf "$DIST_DIR_VERIFICACION"

echo "-> Comprimiendo $ZIP_PATH"
rm -f "$ZIP_PATH" "$CHECKSUM_PATH"
(cd "$DIST_DIR" && zip -r -q -X "$ZIP_PATH" "pluma-engine")

echo "-> Calculando checksum"
# sha256sum registra solo el nombre de archivo (no la ruta absoluta) para que
# el .sha256 sea portable independientemente del directorio de trabajo.
(cd "$RAIZ" && sha256sum "$(basename "$ZIP_PATH")" > "$(basename "$CHECKSUM_PATH")")

echo "-> Limpiando directorio temporal"
rm -rf "$DIST_DIR"

echo "OK: $ZIP_PATH"
echo "OK: $CHECKSUM_PATH"
